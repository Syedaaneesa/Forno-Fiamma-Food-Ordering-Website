generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  price       Int
  image       String
  tag         String
  category    String      @default("Pizza")
  sizes       Json?
  variants    Json?
  addons      Json?
  featured    Boolean     @default(false)
  isDeal      Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SUPERADMIN")
  createdAt    DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  notes         String?
  fulfillment   String      @default("pickup")
  total         Int
  status        String      @default("NEW")
  whatsappSent  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  quantity   Int
  unitPrice  Int
  size       String?
  variant    String?
  addons     Json?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String   @default("website")
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model FootprintEvent {
  id        String   @id @default(cuid())
  event     String
  path      String
  referrer  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
